{
  "name": "@rasahq/rasa-inspector",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "publishConfig": {
    "registry": "https://europe-west3-npm.pkg.dev/rasa-releases/rasa-inspector/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RasaHQ/rasa-private.git"
  },
  "workspaces": [
    "e2e"
  ],
  "scripts": {
    "dev": "yarn prepare:events && vite",
    "build": "yarn build:spa && yarn build:lib",
    "build:spa": "yarn prepare:events && tsc -b && vite build",
    "build:lib": "yarn prepare:events && vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "lint": "yarn prepare:events && eslint .",
    "lint:fix": "yarn prepare:events && eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "prepare:events": "yarn --cwd ../../../../packages/rasa-events install --immutable && yarn --cwd ../../../../packages/rasa-events build",
    "test": "yarn prepare:events && vitest run --coverage",
    "test:e2e": "yarn workspace inspector-e2e e2e",
    "test:e2e:watch": "yarn workspace inspector-e2e e2e:watch",
    "test:e2e:debug": "yarn workspace inspector-e2e e2e:debug",
    "test:watch": "yarn prepare:events && vitest watch",
    "report:e2e": "yarn workspace inspector-e2e report",
    "typecheck": "yarn prepare:events && tsc --noEmit"
  },
  "exports": {
    ".": {
      "types": "./dist/lib/Inspector/index.d.ts",
      "import": "./dist/lib/inspector.js"
    },
    "./types": {
      "types": "./dist/lib/types/index.d.ts",
      "import": "./dist/lib/types.js"
    }
  },
  "files": [
    "dist/lib"
  ],
  "peerDependencies": {
    "@chakra-ui/react": "^3.37.0",
    "@emotion/react": "^11.14.0",
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/pro-light-svg-icons": "7.3.1",
    "@fortawesome/pro-regular-svg-icons": "7.3.1",
    "@fortawesome/pro-solid-svg-icons": "7.3.1",
    "@fortawesome/pro-thin-svg-icons": "7.3.1",
    "@fortawesome/react-fontawesome": "^0.2.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.3",
    "@tanstack/react-store": "^0.11.1",
    "@tanstack/store": "^0.11.1",
    "elkjs": "^0.11.1",
    "immutable-json-patch": "6.0.3",
    "lodash": "4.18.1",
    "next-themes": "^0.4.6",
    "react-icons": "5.7.0",
    "react-markdown": "10.1.0",
    "react-syntax-highlighter": "15.6.6",
    "reactflow": "11.11.4",
    "socket.io-client": "4.8.4",
    "uuid": "11.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@chakra-ui/react": "3.37.0",
    "@emotion/react": "11.14.0",
    "@eslint/compat": "1.4.1",
    "@eslint/js": "9.39.5",
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/pro-light-svg-icons": "7.3.1",
    "@fortawesome/pro-regular-svg-icons": "7.3.1",
    "@fortawesome/pro-solid-svg-icons": "7.3.1",
    "@fortawesome/pro-thin-svg-icons": "7.3.1",
    "@fortawesome/react-fontawesome": "^0.2.6",
    "@rasahq/rasa-events": "portal:../../../../packages/rasa-events",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/lodash": "4.17.26",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-syntax-highlighter": "15.5.13",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "3.2.7",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "9.39.5",
    "eslint-config-prettier": "9.1.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-playwright": "2.12.1",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "jsdom": "26.1.0",
    "lint-staged": "16.4.0",
    "prettier": "3.9.10",
